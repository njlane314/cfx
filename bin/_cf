#!/usr/bin/env python3
import argparse
import datetime as dt
import hashlib
import http.server
import json
import os
import re
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser


ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
BUILD = os.path.join(ROOT, ".build", "cf")
API_CACHE = os.path.join(BUILD, "api")
API_BASE = "https://codeforces.com/api/"
USER_AGENT = "cf-probs/1.0 (+https://codeforces.com)"
DEFAULT_STATUS_COUNT = 10000


class Error(Exception):
    pass


def ensure_dirs():
    os.makedirs(API_CACHE, exist_ok=True)


def eprint(*parts):
    print(*parts, file=sys.stderr)


def clean_cell(value):
    return str(value).replace("\t", " ").replace("\n", " ").strip()


def with_final_newline(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = text.strip("\n")
    return text + "\n"


def format_time(seconds):
    return dt.datetime.fromtimestamp(int(seconds), dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def parse_problem_tokens(tokens):
    if len(tokens) == 2 and re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", tokens[0]) and re.fullmatch(r"\d+", tokens[1]):
        return tokens[1], tokens[0].upper()
    if len(tokens) != 1:
        raise Error("expected problem as A 1985, A.1985, or 1985A")

    token = tokens[0]
    m = re.fullmatch(r"([A-Za-z][A-Za-z0-9]*)\.(\d+)", token)
    if m:
        return m.group(2), m.group(1).upper()

    m = re.fullmatch(r"(\d+)([A-Za-z][A-Za-z0-9]*)", token)
    if m:
        return m.group(1), m.group(2).upper()

    raise Error("expected problem as A 1985, A.1985, or 1985A")


def local_id(contest_id, index):
    return f"{index}.{contest_id}"


def hf_id(contest_id, index):
    return f"{contest_id}/{index}"


def split_local_id(value):
    m = re.fullmatch(r"([A-Za-z][A-Za-z0-9]*)\.(\d+)", value)
    if not m:
        return None
    return m.group(2), m.group(1)


def sort_problem_id(value):
    parsed = split_local_id(value)
    if not parsed:
        return (10**18, value)
    contest_id, index = parsed
    return (int(contest_id), index)


def problem_id(problem):
    contest_id = problem.get("contestId")
    index = problem.get("index")
    if contest_id is not None and index:
        return local_id(contest_id, index)
    if problem.get("problemsetName") and index:
        return f"{problem['problemsetName']}.{index}"
    return index or "?"


def problem_key(problem):
    contest_id = problem.get("contestId")
    index = problem.get("index")
    if contest_id is not None and index:
        return (str(contest_id), str(index))
    return (str(problem.get("problemsetName", "")), str(index or ""))


def solution_path(contest_id, index):
    return os.path.join(ROOT, "solutions", f"{local_id(contest_id, index)}.cpp")


def test_dir(contest_id, index):
    return os.path.join(ROOT, "tests", local_id(contest_id, index))


def create_problem(contest_id, index):
    src = solution_path(contest_id, index)
    tests = test_dir(contest_id, index)
    os.makedirs(os.path.dirname(src), exist_ok=True)
    os.makedirs(tests, exist_ok=True)
    if not os.path.exists(src):
        shutil.copyfile(os.path.join(ROOT, "template.cpp"), src)
    return src, tests


def cache_path(name, payload):
    key = hashlib.sha1(json.dumps([name, payload], sort_keys=True).encode()).hexdigest()
    return os.path.join(API_CACHE, f"{name}-{key}.json")


def http_json(url, params=None, timeout=45):
    if params:
        url = url + "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def throttle_codeforces():
    ensure_dirs()
    last_path = os.path.join(BUILD, "last-api")
    now = time.time()
    try:
        with open(last_path, "r", encoding="utf-8") as f:
            last = float(f.read().strip() or "0")
    except FileNotFoundError:
        last = 0.0
    wait = 2.05 - (now - last)
    if wait > 0:
        time.sleep(wait)
    with open(last_path, "w", encoding="utf-8") as f:
        f.write(str(time.time()))


def api_call(method, params=None, ttl=900, refresh=False):
    ensure_dirs()
    params = {k: str(v) for k, v in (params or {}).items() if v is not None}
    path = cache_path(method, params)
    if not refresh and os.path.exists(path):
        age = time.time() - os.path.getmtime(path)
        if ttl is None or age <= ttl:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)

    throttle_codeforces()
    data = http_json(API_BASE + method, params)
    if data.get("status") != "OK":
        raise Error(f"{method}: {data.get('comment', 'request failed')}")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data["result"], f)
    return data["result"]


def problemset(refresh=False):
    data = api_call("problemset.problems", ttl=24 * 3600, refresh=refresh)
    stats = {}
    for item in data.get("problemStatistics", []):
        stats[(str(item.get("contestId", "")), str(item.get("index", "")))] = item.get("solvedCount", 0)
    rows = []
    for problem in data.get("problems", []):
        key = problem_key(problem)
        rows.append((problem, stats.get(key, 0)))
    return rows


def status_for(handle, count=DEFAULT_STATUS_COUNT, refresh=False):
    return api_call(
        "user.status",
        {"handle": handle, "from": 1, "count": count},
        ttl=10 * 60,
        refresh=refresh,
    )


def solved_sets(submissions):
    solved = set()
    attempted = {}
    for sub in submissions:
        problem = sub.get("problem", {})
        pid = problem_id(problem)
        entry = attempted.setdefault(
            pid,
            {"attempts": 0, "ok": False, "best": "", "name": problem.get("name", ""), "latest": 0},
        )
        entry["attempts"] += 1
        entry["latest"] = max(entry["latest"], sub.get("creationTimeSeconds", 0))
        verdict = sub.get("verdict", "SUBMITTED")
        if not entry["best"] or verdict == "OK":
            entry["best"] = verdict
        if verdict == "OK":
            entry["ok"] = True
            solved.add(pid)
    return solved, attempted


def handle_from_args(value):
    handle = value or os.environ.get("CF_HANDLE")
    if not handle:
        raise Error("missing handle: pass --handle or set CF_HANDLE")
    return handle


def write_problem_tsv(rows):
    ensure_dirs()
    path = os.path.join(BUILD, "problems.tsv")
    with open(path, "w", encoding="utf-8") as f:
        f.write("id\trating\tsolved\tname\ttags\n")
        for problem, solved_count in rows:
            f.write(
                "\t".join(
                    [
                        problem_id(problem),
                        str(problem.get("rating", "")),
                        str(solved_count),
                        clean_cell(problem.get("name", "")),
                        ";".join(problem.get("tags", [])),
                    ]
                )
                + "\n"
            )
    return path


def parse_filter_terms(terms):
    exact = None
    rating = None
    tags = []
    if len(terms) == 2:
        try:
            contest_id, index = parse_problem_tokens(terms)
            exact = local_id(contest_id, index)
            return exact, rating, tags
        except Error:
            pass
    if len(terms) == 1:
        try:
            contest_id, index = parse_problem_tokens(terms)
            exact = local_id(contest_id, index)
            return exact, rating, tags
        except Error:
            pass
    for term in terms:
        if re.fullmatch(r"\d+", term):
            rating = int(term)
        else:
            tags.append(term)
    return exact, rating, tags


def match_problem(problem, solved_count, exact, rating, tags, min_rating=None, max_rating=None):
    pid = problem_id(problem)
    if exact and pid != exact:
        return False
    problem_rating = problem.get("rating")
    if rating is not None and problem_rating != rating:
        return False
    if min_rating is not None and (problem_rating is None or problem_rating < min_rating):
        return False
    if max_rating is not None and (problem_rating is None or problem_rating > max_rating):
        return False
    problem_tags = set(problem.get("tags", []))
    return all(tag in problem_tags for tag in tags)


def print_problem_rows(rows, limit):
    print("id\trating\tsolved\tname\ttags")
    for problem, solved_count in rows[:limit]:
        print(
            "\t".join(
                [
                    problem_id(problem),
                    str(problem.get("rating", "")),
                    str(solved_count),
                    clean_cell(problem.get("name", "")),
                    ";".join(problem.get("tags", [])),
                ]
            )
        )


def cmd_meta(args):
    exact, rating, tags = parse_filter_terms(args.terms)
    rows = problemset(refresh=args.refresh)
    path = write_problem_tsv(rows)
    rows = [
        row
        for row in rows
        if match_problem(row[0], row[1], exact, rating, tags, args.min_rating, args.max_rating)
    ]
    rows.sort(key=lambda row: (sort_problem_id(problem_id(row[0])), problem_id(row[0])))
    limit = len(rows) if args.all else args.limit
    print_problem_rows(rows, limit)
    eprint(f"cache: {path}")
    return 0


def cmd_pick(args):
    terms = list(args.terms)
    handle = args.handle or os.environ.get("CF_HANDLE")
    if not handle and terms and not re.fullmatch(r"\d+", terms[0]):
        handle = terms.pop(0)
    if not handle:
        raise Error("missing handle: pass HANDLE, --handle, or set CF_HANDLE")
    exact, rating, tags = parse_filter_terms(terms)
    if exact:
        raise Error("pick filters by rating/tags, not by one exact problem")

    rows = problemset(refresh=args.refresh)
    submissions = status_for(handle, args.count, refresh=args.refresh)
    solved, _attempted = solved_sets(submissions)

    picks = []
    for problem, solved_count in rows:
        pid = problem_id(problem)
        if pid in solved:
            continue
        if not match_problem(problem, solved_count, None, rating, tags, args.min_rating, args.max_rating):
            continue
        if problem.get("rating") is None:
            continue
        picks.append((problem, solved_count))

    def pick_key(row):
        problem, solved_count = row
        dist = abs(problem.get("rating", 0) - rating) if rating is not None else 0
        return (dist, -int(solved_count), sort_problem_id(problem_id(problem)))

    picks.sort(key=pick_key)
    print_problem_rows(picks, args.limit)
    return 0


def cmd_contest(args):
    contest_id = str(args.contest_id)
    data = api_call("contest.standings", {"contestId": contest_id}, ttl=6 * 3600, refresh=args.refresh)
    problems = data.get("problems", [])
    if not problems:
        raise Error(f"no problems returned for contest {contest_id}")

    ensure_dirs()
    meta_path = os.path.join(BUILD, f"contest-{contest_id}.tsv")
    with open(meta_path, "w", encoding="utf-8") as f:
        f.write("id\tname\trating\ttags\n")
        for problem in problems:
            f.write(
                "\t".join(
                    [
                        local_id(contest_id, problem.get("index", "")),
                        clean_cell(problem.get("name", "")),
                        str(problem.get("rating", "")),
                        ";".join(problem.get("tags", [])),
                    ]
                )
                + "\n"
            )

    for problem in problems:
        index = problem.get("index")
        if not index:
            continue
        src = solution_path(contest_id, index)
        if not args.list:
            src, _tests = create_problem(contest_id, index)
        print(f"{local_id(contest_id, index)}\t{clean_cell(problem.get('name', ''))}\t{src}")
        if args.samples:
            try:
                samples = load_samples(contest_id, index, "auto", args.refresh, args.scan)
                save_samples(contest_id, index, samples, force=args.force)
            except Error as exc:
                eprint(f"sample {local_id(contest_id, index)}: {exc}")
    eprint(f"cache: {meta_path}")
    return 0


def cmd_seen(args):
    handle = handle_from_args(args.handle)
    submissions = status_for(handle, args.count, refresh=args.refresh)
    _solved, attempted = solved_sets(submissions)
    print("id\tstate\tattempts\tbest\tlatest\tname")
    for pid in sorted(attempted, key=sort_problem_id):
        entry = attempted[pid]
        if args.ok and not entry["ok"]:
            continue
        state = "OK" if entry["ok"] else "TRIED"
        latest = format_time(entry["latest"]) if entry["latest"] else ""
        print(
            "\t".join(
                [
                    pid,
                    state,
                    str(entry["attempts"]),
                    entry["best"],
                    latest,
                    clean_cell(entry["name"]),
                ]
            )
        )
    return 0


def cmd_solved(args):
    handle = handle_from_args(args.handle)
    submissions = status_for(handle, args.count, refresh=args.refresh)
    _solved, attempted = solved_sets(submissions)
    src_dir = os.path.join(ROOT, "solutions")
    sources = sorted(
        [name for name in os.listdir(src_dir) if name.endswith(".cpp")],
        key=lambda name: sort_problem_id(name[:-4]),
    )
    print("id\tstate\tattempts\tbest\tname")
    for name in sources:
        pid = name[:-4]
        entry = attempted.get(pid)
        if not entry:
            print(f"{pid}\tNEW\t0\t\t")
            continue
        state = "OK" if entry["ok"] else "TRIED"
        print(f"{pid}\t{state}\t{entry['attempts']}\t{entry['best']}\t{clean_cell(entry['name'])}")
    return 0


def cmd_rank(args):
    if args.mode and args.mode.isdigit() and args.value is None:
        args.value = args.mode
        args.mode = "contest"

    if args.mode == "contests":
        contests = api_call("contest.list", {"gym": "false"}, ttl=3600, refresh=args.refresh)
        upcoming = [c for c in contests if c.get("phase") == "BEFORE" and c.get("startTimeSeconds")]
        upcoming.sort(key=lambda c: c["startTimeSeconds"])
        print("id\tstart\tname")
        for contest in upcoming[: args.limit]:
            print(f"{contest['id']}\t{format_time(contest['startTimeSeconds'])}\t{clean_cell(contest['name'])}")
        return 0

    if args.mode == "contest":
        changes = api_call(
            "contest.ratingChanges",
            {"contestId": args.value},
            ttl=24 * 3600,
            refresh=args.refresh,
        )
        changes.sort(key=lambda row: row.get("rank", 10**18))
        print("rank\thandle\told\tnew\tdelta")
        for row in changes[: args.limit]:
            delta = row.get("newRating", 0) - row.get("oldRating", 0)
            print(f"{row.get('rank')}\t{row.get('handle')}\t{row.get('oldRating')}\t{row.get('newRating')}\t{delta:+d}")
        return 0

    handle = args.value or (args.mode if args.mode != "handle" else None) or os.environ.get("CF_HANDLE")
    if not handle:
        raise Error("usage: rank HANDLE | rank contests | rank contest CONTEST_ID")
    info = api_call("user.info", {"handles": handle}, ttl=3600, refresh=args.refresh)[0]
    rating = api_call("user.rating", {"handle": handle}, ttl=3600, refresh=args.refresh)
    print(
        f"{info.get('handle')}\t{info.get('rank', '')}\t"
        f"{info.get('rating', '')}\tmax {info.get('maxRating', '')}\t"
        f"friends {info.get('friendOfCount', '')}"
    )
    print("contest\tdate\trank\told\tnew\tdelta")
    for row in rating[-args.limit :]:
        delta = row.get("newRating", 0) - row.get("oldRating", 0)
        print(
            f"{clean_cell(row.get('contestName', ''))}\t"
            f"{format_time(row.get('ratingUpdateTimeSeconds', 0))}\t"
            f"{row.get('rank')}\t{row.get('oldRating')}\t{row.get('newRating')}\t{delta:+d}"
        )
    return 0


class CodeforcesSampleParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.in_sample = 0
        self.pending = None
        self.current = None
        self.buf = []
        self.tests = []
        self.line_div = False

    def handle_starttag(self, tag, attrs):
        classes = set()
        for name, value in attrs:
            if name == "class" and value:
                classes.update(value.split())

        if tag == "div" and "sample-test" in classes:
            self.in_sample = 1
            return
        if self.in_sample:
            if tag == "div":
                self.in_sample += 1
                if "input" in classes:
                    self.pending = "input"
                elif "output" in classes:
                    self.pending = "output"
                elif "test-example-line" in classes and self.current:
                    self.line_div = True
            elif tag == "pre" and self.pending:
                self.current = self.pending
                self.buf = []
            elif tag == "br" and self.current:
                self.buf.append("\n")

    def handle_endtag(self, tag):
        if self.current and tag == "pre":
            text = "".join(self.buf).strip("\n")
            if self.current == "input":
                self.tests.append({"input": text, "output": ""})
            else:
                if not self.tests:
                    self.tests.append({"input": "", "output": text})
                else:
                    self.tests[-1]["output"] = text
            self.current = None
            self.buf = []
            return
        if self.current and tag == "div" and self.line_div:
            self.buf.append("\n")
            self.line_div = False
        if self.in_sample and tag == "div":
            self.in_sample -= 1
            if self.in_sample == 0:
                self.pending = None

    def handle_data(self, data):
        if self.current:
            self.buf.append(data)


def fetch_text(url, timeout=45):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 cf-probs/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode("utf-8", "replace")
            status = getattr(response, "status", 200)
            headers = response.headers
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")
        status = exc.code
        headers = exc.headers
    return status, headers, body


def cf_problem_url(contest_id, index):
    return f"https://codeforces.com/problemset/problem/{contest_id}/{index}?locale=en"


def samples_from_codeforces_page(contest_id, index):
    status, headers, body = fetch_text(cf_problem_url(contest_id, index))
    mitigated = headers.get("cf-mitigated", "")
    if status == 403 or mitigated == "challenge" or "browser is being checked" in body:
        raise Error("Codeforces HTML is behind a browser challenge from this client")
    parser = CodeforcesSampleParser()
    parser.feed(body)
    tests = [test for test in parser.tests if test.get("input") or test.get("output")]
    if not tests:
        raise Error("no samples found in Codeforces HTML")
    return tests


def hf_request(endpoint, params, timeout=15):
    url = "https://datasets-server.huggingface.co/" + endpoint + "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            status = getattr(response, "status", 200)
            body = response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        status = exc.code
        body = exc.read().decode("utf-8", "replace")
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        raise Error(f"HTTP {status} from Hugging Face dataset server")
    if status >= 400 and "error" not in data:
        raise Error(f"HTTP {status} from Hugging Face dataset server")
    return data


def samples_from_huggingface(contest_id, index, refresh=False):
    ensure_dirs()
    cache = os.path.join(BUILD, f"hfsample-{contest_id}-{index}.json")
    if not refresh and os.path.exists(cache):
        with open(cache, "r", encoding="utf-8") as f:
            return json.load(f)

    where = f"\"id\"='{hf_id(contest_id, index)}'"
    errors = []
    for split in ["train", "test"]:
        try:
            data = hf_request(
                "filter",
                {
                    "dataset": "open-r1/codeforces",
                    "config": "default",
                    "split": split,
                    "where": where,
                    "length": 1,
                },
            )
        except Exception as exc:
            errors.append(str(exc))
            continue
        if data.get("error"):
            errors.append(data["error"])
            continue
        rows = data.get("rows", [])
        if rows:
            examples = rows[0].get("row", {}).get("examples") or []
            if examples:
                with open(cache, "w", encoding="utf-8") as f:
                    json.dump(examples, f)
                return examples
    detail = "; ".join(dict.fromkeys(errors)) if errors else "not found"
    raise Error(f"Hugging Face examples unavailable: {detail}")


def load_samples(contest_id, index, source, refresh=False, scan=False):
    errors = []
    if source in ("auto", "cf"):
        try:
            return samples_from_codeforces_page(contest_id, index)
        except Error as exc:
            errors.append(str(exc))
            if source == "cf":
                raise
    if source in ("auto", "hf"):
        try:
            return samples_from_huggingface(contest_id, index, refresh=refresh)
        except Error as exc:
            errors.append(str(exc))
            if source == "hf":
                raise
    raise Error("; ".join(errors) if errors else "no sample source selected")


def save_samples(contest_id, index, samples, force=False):
    _src, tests = create_problem(contest_id, index)
    written = 0
    for i, sample in enumerate(samples, 1):
        in_path = os.path.join(tests, f"case-{i}.in")
        out_path = os.path.join(tests, f"case-{i}.out")
        for path, key in [(in_path, "input"), (out_path, "output")]:
            if os.path.exists(path) and not force:
                print(f"exists: {path}")
                continue
            with open(path, "w", encoding="utf-8") as f:
                f.write(with_final_newline(sample.get(key, "")))
            print(f"wrote: {path}")
            written += 1
    return written


def print_samples(samples):
    for i, sample in enumerate(samples, 1):
        print(f"==> case-{i}.in")
        print(with_final_newline(sample.get("input", "")), end="")
        print(f"==> case-{i}.out")
        print(with_final_newline(sample.get("output", "")), end="")


def cmd_sample(args):
    contest_id, index = parse_problem_tokens(args.problem)
    samples = load_samples(contest_id, index, args.source, args.refresh, args.scan)
    if args.print:
        print_samples(samples)
    else:
        save_samples(contest_id, index, samples, force=args.force)
    return 0


def parse_url_problem(url):
    patterns = [
        r"/problemset/problem/(\d+)/([A-Za-z][A-Za-z0-9]*)",
        r"/contest/(\d+)/problem/([A-Za-z][A-Za-z0-9]*)",
        r"/gym/(\d+)/problem/([A-Za-z][A-Za-z0-9]*)",
    ]
    for pattern in patterns:
        m = re.search(pattern, url)
        if m:
            return m.group(1), m.group(2).upper()
    raise Error(f"cannot read contest/index from URL: {url}")


def import_companion_package(data, force=False):
    contest_id, index = parse_url_problem(data.get("url", ""))
    tests = [{"input": item.get("input", ""), "output": item.get("output", "")} for item in data.get("tests", [])]
    if not tests:
        raise Error("Competitive Companion package has no tests")
    create_problem(contest_id, index)
    save_samples(contest_id, index, tests, force=force)
    return local_id(contest_id, index), len(tests)


def cmd_cc(args):
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            length = int(self.headers.get("Content-Length", "0"))
            raw = self.rfile.read(length)
            try:
                data = json.loads(raw.decode("utf-8"))
                pid, count = import_companion_package(data, force=args.force)
                body = f"imported {pid} ({count} samples)\n".encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/plain")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                if args.once:
                    self.server.stop_after_request = True
            except Exception as exc:
                body = (str(exc) + "\n").encode()
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

        def log_message(self, fmt, *values):
            eprint(fmt % values)

    server = http.server.HTTPServer((args.host, args.port), Handler)
    server.stop_after_request = False
    eprint(f"listening on http://{args.host}:{args.port}")
    if args.once:
        server.handle_request()
    else:
        try:
            while True:
                server.handle_request()
                if server.stop_after_request:
                    break
        except KeyboardInterrupt:
            pass
    return 0


def add_common(parser):
    parser.add_argument("--refresh", action="store_true", help="ignore cached API data")


def build_parser():
    parser = argparse.ArgumentParser(prog=os.path.basename(sys.argv[0]))
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("meta", help="cache/list problem metadata")
    add_common(p)
    p.add_argument("terms", nargs="*")
    p.add_argument("--min", dest="min_rating", type=int)
    p.add_argument("--max", dest="max_rating", type=int)
    p.add_argument("-n", "--limit", type=int, default=25)
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_meta)

    p = sub.add_parser("pick", help="suggest unsolved problems")
    add_common(p)
    p.add_argument("terms", nargs="*")
    p.add_argument("--handle")
    p.add_argument("--count", type=int, default=DEFAULT_STATUS_COUNT)
    p.add_argument("--min", dest="min_rating", type=int)
    p.add_argument("--max", dest="max_rating", type=int)
    p.add_argument("-n", "--limit", type=int, default=20)
    p.set_defaults(func=cmd_pick)

    p = sub.add_parser("contest", help="bootstrap a contest")
    add_common(p)
    p.add_argument("contest_id")
    p.add_argument("--list", action="store_true", help="show contest problems without creating files")
    p.add_argument("--samples", action="store_true")
    p.add_argument("--force", action="store_true")
    p.add_argument("--scan", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_contest)

    p = sub.add_parser("seen", help="list a user's attempted problems")
    add_common(p)
    p.add_argument("handle", nargs="?")
    p.add_argument("--count", type=int, default=DEFAULT_STATUS_COUNT)
    p.add_argument("--ok", action="store_true")
    p.set_defaults(func=cmd_seen)

    p = sub.add_parser("solved", help="compare local files to accepted submissions")
    add_common(p)
    p.add_argument("handle", nargs="?")
    p.add_argument("--count", type=int, default=DEFAULT_STATUS_COUNT)
    p.set_defaults(func=cmd_solved)

    p = sub.add_parser("rank", help="show rating or contest schedule")
    add_common(p)
    p.add_argument("mode", nargs="?", default="handle")
    p.add_argument("value", nargs="?")
    p.add_argument("-n", "--limit", type=int, default=10)
    p.set_defaults(func=cmd_rank)

    p = sub.add_parser("sample", help="fetch public sample tests")
    add_common(p)
    p.add_argument("problem", nargs="+")
    p.add_argument("--source", choices=["auto", "cf", "hf"], default="auto")
    p.add_argument("--force", action="store_true")
    p.add_argument("--print", action="store_true")
    p.add_argument("--scan", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_sample)

    p = sub.add_parser("cc", help="listen for Competitive Companion packages")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=27121)
    p.add_argument("--once", action="store_true")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_cc)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except Error as exc:
        eprint(f"{args.cmd}: {exc}")
        return 1
    except urllib.error.URLError as exc:
        eprint(f"{args.cmd}: network error: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
