#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

store_id() {
    if [ $# -eq 2 ]; then
        printf '%s.%s\n' "$1" "$2"
    else
        printf '%s\n' "$1" | sed -E 's/^([0-9]+)([A-Za-z][A-Za-z0-9]*)$/\2.\1/'
    fi
}

resolve_source() {
    if [ $# -eq 0 ]; then
        SRC=$(find "$ROOT/solutions" -maxdepth 1 -name '*.cpp' -type f -exec ls -t {} + 2>/dev/null | sed -n '1p')
        if [ -n "$SRC" ]; then
            ID=$(basename -- "$SRC" .cpp)
            return
        fi

        echo "usage: rerun A 1985" >&2
        echo "   or: rerun all" >&2
        exit 2
    fi

    if [ $# -gt 2 ]; then
        echo "usage: rerun A 1985" >&2
        echo "   or: rerun all" >&2
        exit 2
    fi

    arg=$1
    if [ $# -eq 1 ] && [ -f "$arg" ]; then
        SRC=$arg
        ID=$(basename -- "$SRC" .cpp)
        return
    fi

    id=$(store_id "$@")
    if [ -f "$ROOT/solutions/$id.cpp" ]; then
        SRC="$ROOT/solutions/$id.cpp"
        ID=$id
        return
    fi

    if [ $# -eq 1 ] && [ -f "$ROOT/$arg" ]; then
        SRC="$ROOT/$arg"
        ID=$(basename -- "$SRC" .cpp)
        return
    fi

    echo "rerun: source not found for '$arg'" >&2
    echo "expected: solutions/$id.cpp" >&2
    exit 1
}

run_all() {
    found=0
    status=0

    for src in $(find "$ROOT/solutions" -maxdepth 1 -name '*.cpp' -type f | sort); do
        found=1
        id=$(basename -- "$src" .cpp)
        printf '\n==> %s\n' "$id"
        if "$ROOT/bin/rerun" "$src"; then
            :
        else
            status=1
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo "no solutions found in $ROOT/solutions" >&2
        exit 2
    fi

    exit "$status"
}

list_cases() {
    find "$1" -maxdepth 1 -type f -name 'case-*.in' | awk '
    {
        path = $0
        name = $0
        sub(/^.*\//, "", name)
        key = name
        sub(/^case-/, "", key)
        sub(/\.in$/, "", key)
        printf "%d\t%s\n", key + 0, path
    }
    ' | sort -n -k1,1 -k2,2 | cut -f2-
}

if [ "$#" -eq 1 ] && [ "$1" = all ]; then
    run_all
fi

resolve_source "$@"

SRC_DIR=$(dirname -- "$SRC")
BUILD="$ROOT/.build/$ID"
BIN="$BUILD/main"

if [ ! -x "$BIN" ]; then
    echo "missing binary: $BIN" >&2
    echo "compile first: make run $ID" >&2
    exit 1
fi

if [ "$SRC" -nt "$BIN" ]; then
    echo "stale binary: $ID source is newer than $BIN" >&2
fi

TEST_DIR="$ROOT/tests/$ID"
if [ ! -d "$TEST_DIR" ] && [ -d "$SRC_DIR/tests" ]; then
    TEST_DIR="$SRC_DIR/tests"
fi
if [ ! -d "$TEST_DIR" ]; then
    echo "cached: $BIN"
    echo "no tests directory: $TEST_DIR"
    exit 0
fi

pass=0
total=0
found=0

run_case() {
    in_file=$1
    [ -f "$in_file" ] || return 0
    found=1
    total=$((total + 1))

    name=$(basename -- "$in_file")
    stem=${in_file%.*}
    ans_file=""

    [ -f "$stem.out" ] && ans_file="$stem.out"

    out_file="$BUILD/out_$total.txt"
    err_file="$BUILD/err_$total.txt"
    status=0

    echo "==> $name"
    if command -v timeout >/dev/null 2>&1; then
        timeout "${TL:-5}" "$BIN" < "$in_file" > "$out_file" 2> "$err_file" || status=$?
    else
        "$BIN" < "$in_file" > "$out_file" 2> "$err_file" || status=$?
    fi

    if [ "$status" -ne 0 ]; then
        echo "runtime failure: exit $status"
        [ -s "$err_file" ] && cat "$err_file" >&2
        echo
        return 0
    fi

    if [ -s "$err_file" ]; then
        echo "stderr:" >&2
        cat "$err_file" >&2
    fi

    if [ -n "$ans_file" ]; then
        ans_norm="$BUILD/ans_$total.norm.txt"
        out_norm="$BUILD/out_$total.norm.txt"
        sed 's/[[:space:]]*$//' "$ans_file" > "$ans_norm"
        sed 's/[[:space:]]*$//' "$out_file" > "$out_norm"
        if diff -u -B "$ans_norm" "$out_norm"; then
            echo "OK"
            pass=$((pass + 1))
        else
            echo "WA"
        fi
    else
        echo "output:"
        cat "$out_file"
        pass=$((pass + 1))
    fi
    echo
}

for in_file in $(list_cases "$TEST_DIR"); do
    run_case "$in_file"
done

if [ "$found" -eq 0 ]; then
    echo "cached: $BIN"
    echo "no tests found: use $TEST_DIR/case-1.in + case-1.out"
    exit 0
fi

echo "$pass/$total passed"
[ "$pass" -eq "$total" ]
