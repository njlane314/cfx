#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

store_id() {
    if [ $# -eq 2 ]; then
        printf '%s.%s\n' "$1" "$2"
    else
        printf '%s\n' "$1" | sed -E 's/^([0-9]+)([A-Za-z][A-Za-z0-9]*)$/\2.\1/'
    fi
}

run_all() {
    found=0
    status=0

    for src in $(find "$ROOT/solutions" -maxdepth 1 -name '*.cpp' -type f | sort); do
        found=1
        id=$(basename -- "$src" .cpp)
        printf '\n==> %s\n' "$id"
        if "$ROOT/bin/run" "$src"; then
            :
        else
            status=1
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo "no solutions found in $ROOT/solutions" >&2
        exit 2
    fi

    exit "$status"
}

list_cases() {
    find "$1" -maxdepth 1 -type f -name 'case-*.in' | awk '
    {
        path = $0
        name = $0
        sub(/^.*\//, "", name)
        key = name
        sub(/^case-/, "", key)
        sub(/\.in$/, "", key)
        printf "%d\t%s\n", key + 0, path
    }
    ' | sort -n -k1,1 -k2,2 | cut -f2-
}

file_size() {
    if stat -f %z "$1" >/dev/null 2>&1; then
        stat -f %z "$1"
    else
        stat -c %s "$1"
    fi
}

format_bytes() {
    awk -v bytes="$1" '
    BEGIN {
        if (bytes < 1024) {
            printf "%dB", bytes
        } else if (bytes < 1048576) {
            printf "%.1fKiB", bytes / 1024
        } else {
            printf "%.1fMiB", bytes / 1048576
        }
    }
    '
}

format_ms() {
    awk -v ms="$1" '
    BEGIN {
        if (ms < 1000) {
            printf "%dms", ms
        } else {
            printf "%.3fs", ms / 1000
        }
    }
    '
}

report_size() {
    src_size=$(file_size "$SRC")
    bin_size=$(file_size "$BIN")
    echo "size: source $(format_bytes "$src_size"), binary $(format_bytes "$bin_size")"
}

check_enabled() {
    case "${CHECK:-0}" in
        1|yes|true|on) return 0 ;;
        *) return 1 ;;
    esac
}

compiler_probe_flags() {
    if $CXX --version 2>/dev/null | grep -qi clang; then
        printf '%s\n' "-Werror=unknown-warning-option -Werror=unused-command-line-argument"
    fi
}

supports_cxx_flag() {
    flag=$1
    check_bin="$BUILD/.cxx_flag_check"
    probe_flags=$(compiler_probe_flags)

    if printf '#include <iostream>\nint main(){return 0;}\n' | \
        $CXX -std="$STD" $CXXFLAGS $probe_flags "$flag" -x c++ - -o "$check_bin" >/dev/null 2>&1; then
        rm -f "$check_bin"
        return 0
    fi

    rm -f "$check_bin"
    return 1
}

append_supported_cxx_flag() {
    flag=$1
    if supports_cxx_flag "$flag"; then
        CXXFLAGS="$CXXFLAGS $flag"
    fi
}

enable_check_flags() {
    check_enabled || return 0

    for flag in \
        -pedantic \
        -Wformat=2 \
        -Wfloat-equal \
        -Wconversion \
        -Wlogical-op \
        -Wshift-overflow=2 \
        -Wduplicated-cond \
        -Wcast-qual \
        -Wcast-align
    do
        append_supported_cxx_flag "$flag"
    done

    CXXFLAGS="$CXXFLAGS -D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC"
    if [ "$(uname -s 2>/dev/null || true)" = Linux ]; then
        CXXFLAGS="$CXXFLAGS -D_FORTIFY_SOURCE=2"
    fi

    for flag in \
        -fsanitize=address \
        -fsanitize=undefined \
        -fno-sanitize-recover \
        -fstack-protector
    do
        append_supported_cxx_flag "$flag"
    done
}

run_timed() {
    bin=$1
    in_file=$2
    out_file=$3
    err_file=$4
    time_file=$5

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$bin" "$in_file" "$out_file" "$err_file" "$time_file" "${TL:-5}" <<'PY'
import subprocess
import sys
import time

bin_path, in_path, out_path, err_path, time_path, limit = sys.argv[1:]
start = time.perf_counter()
status = 0

try:
    with open(in_path, "rb") as inp, open(out_path, "wb") as out, open(err_path, "wb") as err:
        run = subprocess.run([bin_path], stdin=inp, stdout=out, stderr=err, timeout=float(limit))
        status = run.returncode
except subprocess.TimeoutExpired:
    status = 124
except Exception as exc:
    with open(err_path, "ab") as err:
        err.write((str(exc) + "\n").encode())
    status = 127

elapsed_ms = max(0, round((time.perf_counter() - start) * 1000))
with open(time_path, "w") as out:
    out.write(str(elapsed_ms) + "\n")

sys.exit(status)
PY
    else
        status=0
        if command -v timeout >/dev/null 2>&1; then
            { time -p timeout "${TL:-5}" "$bin" < "$in_file" > "$out_file" 2> "$err_file"; } 2> "$time_file" || status=$?
        else
            { time -p "$bin" < "$in_file" > "$out_file" 2> "$err_file"; } 2> "$time_file" || status=$?
        fi
        awk '/^real / { printf "%d\n", ($2 * 1000) + 0.5 }' "$time_file" > "$time_file.ms"
        mv "$time_file.ms" "$time_file"
        return "$status"
    fi
}

resolve_source() {
    if [ $# -eq 0 ]; then
        SRC=$(find "$ROOT/solutions" -maxdepth 1 -name '*.cpp' -type f -exec ls -t {} + 2>/dev/null | sed -n '1p')
        if [ -n "$SRC" ]; then
            ID=$(basename -- "$SRC" .cpp)
            return
        fi

        echo "usage: run A 1985" >&2
        echo "   or: run solutions/A.1985.cpp" >&2
        exit 2
    fi

    if [ $# -gt 2 ]; then
        echo "usage: run A 1985" >&2
        echo "   or: run solutions/A.1985.cpp" >&2
        exit 2
    fi

    arg=$1
    if [ $# -eq 1 ] && [ -f "$arg" ]; then
        SRC=$arg
        ID=$(basename -- "$SRC" .cpp)
        return
    fi

    id=$(store_id "$@")
    if [ -f "$ROOT/solutions/$id.cpp" ]; then
        SRC="$ROOT/solutions/$id.cpp"
        ID=$id
        return
    fi

    if [ $# -eq 1 ] && [ -f "$ROOT/$arg" ]; then
        SRC="$ROOT/$arg"
        ID=$(basename -- "$SRC" .cpp)
        return
    fi

    echo "run: source not found for '$arg'" >&2
    echo "expected: solutions/$id.cpp" >&2
    exit 1
}

if [ "$#" -eq 1 ] && [ "$1" = all ]; then
    run_all
fi

resolve_source "$@"

SRC_DIR=$(dirname -- "$SRC")
BUILD="$ROOT/.build/$ID"
mkdir -p "$BUILD"

BIN="$BUILD/main"

CXX=${CXX:-g++}
STD=${STD:-gnu++20}
CXXFLAGS=${CXXFLAGS:--O2 -pipe -Wall -Wextra -Wshadow -Wformat=2 -DLOCAL}

ensure_cxx_headers() {
    check_bin="$BUILD/.cxx_header_check"
    if printf '#include <iostream>\nint main(){return 0;}\n' | \
        $CXX -std="$STD" $CXXFLAGS -x c++ - -o "$check_bin" >/dev/null 2>&1; then
        rm -f "$check_bin"
        return
    fi

    if command -v xcrun >/dev/null 2>&1; then
        sdk=$(xcrun --show-sdk-path 2>/dev/null || true)
        if [ -n "$sdk" ] && [ -d "$sdk/usr/include/c++/v1" ]; then
            CXXFLAGS="$CXXFLAGS -isystem $sdk/usr/include/c++/v1"
        fi
    fi
    rm -f "$check_bin"
}

ensure_cxx_headers
enable_check_flags
# shellcheck disable=SC2086
"$ROOT/bin/bundle" "$SRC" | $CXX -std="$STD" $CXXFLAGS -I"$ROOT/include" -x c++ - -o "$BIN"
report_size

TEST_DIR="$ROOT/tests/$ID"
if [ ! -d "$TEST_DIR" ] && [ -d "$SRC_DIR/tests" ]; then
    TEST_DIR="$SRC_DIR/tests"
fi
if [ ! -d "$TEST_DIR" ]; then
    echo "compiled: $SRC"
    echo "no tests directory: $TEST_DIR"
    exit 0
fi

pass=0
total=0
found=0
total_ms=0

run_case() {
    in_file=$1
    [ -f "$in_file" ] || return 0
    found=1
    total=$((total + 1))

    name=$(basename -- "$in_file")
    stem=${in_file%.*}
    ans_file=""

    [ -f "$stem.out" ] && ans_file="$stem.out"

    out_file="$BUILD/out_$total.txt"
    err_file="$BUILD/err_$total.txt"
    time_file="$BUILD/time_$total.txt"
    status=0

    echo "==> $name"
    run_timed "$BIN" "$in_file" "$out_file" "$err_file" "$time_file" || status=$?
    elapsed_ms=$(cat "$time_file")
    elapsed_ms=${elapsed_ms:-0}
    total_ms=$((total_ms + elapsed_ms))
    elapsed=$(format_ms "$elapsed_ms")

    if [ "$status" -ne 0 ]; then
        echo "runtime failure: exit $status ($elapsed)"
        [ -s "$err_file" ] && cat "$err_file" >&2
        echo
        return 0
    fi

    if [ -s "$err_file" ]; then
        echo "stderr:" >&2
        cat "$err_file" >&2
    fi

    if [ -n "$ans_file" ]; then
        ans_norm="$BUILD/ans_$total.norm.txt"
        out_norm="$BUILD/out_$total.norm.txt"
        sed 's/[[:space:]]*$//' "$ans_file" > "$ans_norm"
        sed 's/[[:space:]]*$//' "$out_file" > "$out_norm"
        if diff -u -B "$ans_norm" "$out_norm"; then
            echo "OK ($elapsed)"
            pass=$((pass + 1))
        else
            echo "WA ($elapsed)"
        fi
    else
        echo "output:"
        cat "$out_file"
        echo "OK ($elapsed)"
        pass=$((pass + 1))
    fi
    echo
}

for in_file in $(list_cases "$TEST_DIR"); do
    run_case "$in_file"
done

if [ "$found" -eq 0 ]; then
    echo "compiled: $SRC"
    echo "no tests found: use $TEST_DIR/case-1.in + case-1.out"
    exit 0
fi

echo "$pass/$total passed, time $(format_ms "$total_ms")"
[ "$pass" -eq "$total" ]
