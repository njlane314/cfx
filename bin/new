#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ $# -lt 2 ]; then
    echo "usage: new A 71" >&2
    echo "   or: new A-H 1985" >&2
    exit 2
fi

SPECS=
while [ $# -gt 1 ]; do
    SPECS="$SPECS $1"
    shift
done
CONTEST=$1

expand_specs() {
    printf '%s\n' "$@" | tr ' ' '\n' | awk '
    BEGIN { chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" }
    /^[A-Z]-[A-Z]$/ {
        a = index(chars, substr($0, 1, 1));
        b = index(chars, substr($0, 3, 1));
        if (a > 0 && b >= a) {
            for (i = a; i <= b; ++i) print substr(chars, i, 1);
            next;
        }
    }
    NF { print }
    '
}

IDS=$(for P in $(expand_specs $SPECS); do printf '%s.%s\n' "$P" "$CONTEST"; done)

for ID in $IDS; do
    SRC="$ROOT/solutions/$ID.cpp"
    TEST_DIR="$ROOT/tests/$ID"

    mkdir -p "$ROOT/solutions" "$TEST_DIR"
    if [ ! -f "$SRC" ]; then
        cp "$ROOT/template.cpp" "$SRC"
    fi
    echo "$SRC"
done
