{
  "manifest_version": 3,
  "name": "cfx connector",
  "version": "0.1.5",
  "key": "",
  "description": "Moves Codeforces samples and submissions through the local cfx workbench.",
  "homepage_url": "https://github.com/njlane314/cfx",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/problem/*/*",
        "https://codeforces.com/contest/*/submit*",
        "https://codeforces.com/problemset/submit*",
        "https://codeforces.com/problemset/status*",
        "https://codeforces.com/contest/*/my*",
        "https://codeforces.com/contest/*/status*",
        "https://codeforces.com/contest/*/submission/*",
        "https://codeforces.com/problemset/submission/*/*",
        "https://codeforces.com/submissions/*",
        "https://codeforces.com/enter*"
      ],
      "js": [
        "samples.js",
        "submission.js",
        "connector.js"
      ],
      "run_at": "document_start"
    }
  ]
}
