{
  "manifest_version": 3,
  "name": "cf-probs connector",
  "version": "0.1.0",
  "description": "Moves Codeforces samples and submissions through the local cf-probs workbench.",
  "host_permissions": [
    "https://codeforces.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/problem/*/*",
        "https://codeforces.com/contest/*/submit*"
      ],
      "js": [
        "connector.js"
      ],
      "run_at": "document_start"
    }
  ]
}
